[Unit]
Description=Calculator Readiness activity authentication
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/calculatorreadiness/activity-auth.env
ExecStart=/usr/bin/node /opt/calculatorreadiness/activity-auth.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
