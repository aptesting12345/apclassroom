#!/usr/bin/env bash
set -Eeuo pipefail

repo="/home/evanmholland/apclassroom"
web_root="/var/www/calculatorreadiness"
backup_root="/var/www/calculatorreadiness.previous"
lock_file="/run/lock/calculatorreadiness-deploy.lock"
state_dir="/var/lib/calculatorreadiness"
deployed_file="$state_dir/deployed-commit"
repo_user="evanmholland"
nginx_activity_snippet="/etc/nginx/snippets/calculatorreadiness-activities.conf"
nginx_activity_backup="/etc/nginx/snippets/calculatorreadiness-activities.conf.previous"

repo_git() {
  runuser -u "$repo_user" -- git -C "$repo" "$@"
}

exec 9>"$lock_file"
flock -n 9 || exit 0

repo_git fetch --quiet origin main
current_commit="$(repo_git rev-parse HEAD)"
remote_commit="$(repo_git rev-parse origin/main)"
deployed_commit="$(cat "$deployed_file" 2>/dev/null || true)"

if [[ "$deployed_commit" == "$remote_commit" ]]; then
  exit 0
fi

stage="$(mktemp -d /var/www/calculatorreadiness.deploy.XXXXXX)"
cleanup() {
  rm -rf "$stage"
}
trap cleanup EXIT

repo_git archive origin/main | tar -x -C "$stage"

test -s "$stage/index.html"
test -s "$stage/game-guard.js"
test -s "$stage/.well-known/security.txt"
test -s "$stage/activities/index.html"
test -s "$stage/activities/4/JavaScript/Touchscreen.js"
if ! systemctl is-active --quiet calculatorreadiness-activity-auth.service; then
  echo "Refusing deployment: activity authentication is not active." >&2
  exit 1
fi
if ! nginx -T 2>&1 | grep -Fq 'location ^~ /activities/'; then
  echo "Refusing deployment: the protected /activities/ Nginx location is not loaded." >&2
  exit 1
fi
if grep -Fq 'document.querySelector("button")?.click()' "$stage/activities/4/JavaScript/Touchscreen.js"; then
  echo "Refusing deployment: the Slope calculator-overlay bug is present." >&2
  exit 1
fi

chmod -R a+rX "$stage"
rm -rf "$backup_root"
cp -a "$web_root" "$backup_root"
install -d -m 0755 /opt/calculatorreadiness
install -m 0644 "$stage/server/activity-auth.py" /opt/calculatorreadiness/activity-auth.py
systemctl restart calculatorreadiness-activity-auth.service
cp -a "$nginx_activity_snippet" "$nginx_activity_backup"
install -m 0644 "$stage/deploy/nginx-activities.conf" "$nginx_activity_snippet"
rsync -a --delete --exclude='.git/' --exclude='deploy/' --exclude='server/' --exclude='functions/' --exclude='_routes.json' --exclude='CNAME' --exclude='README.md' "$stage/" "$web_root/"

if ! nginx -t; then
  cp -a "$nginx_activity_backup" "$nginx_activity_snippet"
  rsync -a --delete "$backup_root/" "$web_root/"
  exit 1
fi

repo_git reset --hard "$remote_commit" >/dev/null
systemctl reload nginx
install -d -m 0755 "$state_dir"
printf '%s\n' "$remote_commit" > "$deployed_file"
echo "Deployed $remote_commit"
