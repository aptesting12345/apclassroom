#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  echo "Run this installer with sudo." >&2
  exit 1
fi
if [[ "$#" -ne 1 || -z "$1" ]]; then
  echo "Usage: sudo ./deploy/install-activities-auth ACCESS_CODE" >&2
  exit 1
fi

repo="$(cd "$(dirname "$0")/.." && pwd)"
install -d -m 0755 /opt/calculatorreadiness /etc/calculatorreadiness
install -m 0644 "$repo/server/activity-auth.mjs" /opt/calculatorreadiness/activity-auth.mjs
install -m 0644 "$repo/deploy/calculatorreadiness-activity-auth.service" /etc/systemd/system/calculatorreadiness-activity-auth.service
install -m 0644 "$repo/deploy/nginx-activities.conf" /etc/nginx/snippets/calculatorreadiness-activities.conf

if ! nginx -T 2>&1 | grep -Fq 'location ^~ /activities/'; then
  active_config="$(nginx -T 2>&1 | awk '
    $1 == "#" && $2 == "configuration" && $3 == "file" { file=$4; sub(/:$/, "", file) }
    index($0, "root /var/www/calculatorreadiness") { print file; exit }
  ')"
  if [[ -z "$active_config" ]]; then
    echo "Could not locate the active calculatorreadiness Nginx configuration." >&2
    exit 2
  fi
  active_config="$(readlink -f "$active_config")"
  backup_config="${active_config}.before-activities"
  cp -a "$active_config" "$backup_config"
  patched_config="$(mktemp)"
  awk '
    { print }
    !added && $0 ~ /^[[:space:]]*server[[:space:]]*\{/ {
      print "    include /etc/nginx/snippets/calculatorreadiness-activities.conf;"
      added=1
    }
    END { if (!added) exit 3 }
  ' "$active_config" > "$patched_config" || {
    rm -f "$patched_config"
    echo "Found $active_config, but could not locate its server block." >&2
    exit 2
  }
  install -m "$(stat -c '%a' "$active_config")" "$patched_config" "$active_config"
  rm -f "$patched_config"
  if ! nginx -t; then
    cp -a "$backup_config" "$active_config"
    echo "Nginx validation failed; the original configuration was restored." >&2
    exit 2
  fi
  echo "Added protected activity routes to $active_config"
fi

secret="$(openssl rand -hex 32)"
umask 077
printf 'ACTIVITIES_ACCESS_CODE=%s\nACTIVITIES_SESSION_SECRET=%s\n' "$1" "$secret" > /etc/calculatorreadiness/activity-auth.env

systemctl daemon-reload
systemctl enable --now calculatorreadiness-activity-auth.service
if ! systemctl is-active --quiet calculatorreadiness-activity-auth.service; then
  journalctl -u calculatorreadiness-activity-auth.service -n 20 --no-pager >&2
  echo "Activity authentication did not start." >&2
  exit 2
fi
auth_status="$(curl -sS -o /dev/null -w '%{http_code}' http://127.0.0.1:8765/check || true)"
if [[ "$auth_status" != "401" ]]; then
  journalctl -u calculatorreadiness-activity-auth.service -n 20 --no-pager >&2
  echo "Activity authentication health check failed with status ${auth_status:-unavailable}." >&2
  exit 2
fi

nginx -t
install -m 0755 "$repo/deploy/deploy-calculatorreadiness" /usr/local/sbin/deploy-calculatorreadiness
systemctl reload nginx
systemctl start calculatorreadiness-deploy.service
echo "Activity authentication and protected deployment are ready."
